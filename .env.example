# Copy to .env and adjust if needed. setup.sh creates .env automatically if it is missing.

# LAN IP of your Synology (NOT 127.0.0.1 - Audio Station refuses loopback addresses).
# Empty = auto-detect.
NAS_IP=

# Port the relay listens on (any free port).
RELAY_PORT=18570

# DNS server the relay asks for the real yp.shoutcast.com address (your router is fine).
# Empty = first nameserver in /etc/resolv.conf. DNS-over-HTTPS is used as fallback.
RELAY_DNS=

# Max simultaneous radio streams. Starting one more closes the oldest
# (this also cleans up streams Audio Station forgets to close).
RELAY_MAX_ACTIVE=3

# Bitrate used when converting AAC/AAC+ stations to MP3.
RELAY_MP3_BITRATE=192k
